# Copy this file to `.env.local` and fill in the values.
# `.env.local` is automatically ignored by git, so your secrets stay private.

# ---------------------------------------------------------------------------
# Newsletter / member signup endpoint
# ---------------------------------------------------------------------------
# Paste the "Web app URL" from the Newsletter Google Apps Script deployment.
# See NEWSLETTER_SETUP.md for the step-by-step setup guide.
#
# If this variable is left empty, the newsletter form will fall back to
# opening the visitor's email app with their info pre-filled — the site
# still works, the data just arrives by email instead of in the sheet.

NEXT_PUBLIC_NEWSLETTER_ENDPOINT=

# ---------------------------------------------------------------------------
# Event RSVP endpoint (Upcoming Events section)
# ---------------------------------------------------------------------------
# Paste the "Web app URL" from your RSVP Google Apps Script deployment.
# See RSVP_SETUP.md for the step-by-step setup guide.
#
# When this is empty, the Upcoming Events RSVP form is disabled and visitors
# are shown a "call to reserve" prompt instead.

NEXT_PUBLIC_RSVP_ENDPOINT=
